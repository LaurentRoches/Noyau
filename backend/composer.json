{
    "name": "laurentroches/corebound-backend",
    "description": "Moteur de simulation Corebound",
    "type": "project",
    "version": "0.1.0",
    "license": "proprietary",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit tests",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs": "php-cs-fixer fix",
        "stan": "phpstan analyse src"
    }
}